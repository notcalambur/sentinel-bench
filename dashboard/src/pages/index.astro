---
import Base from '../layouts/Base.astro';
import ThreatMap from '../components/ThreatMap.astro';
---

<Base title="Sentinel-Bench — Personal Cyber Threat Intelligence" active="landing">

  <ThreatMap />

  <main class="landing landing-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-inner">
        <div class="tac-bracket tac-label tac-label--accent">
          Personal Cyber Threat Intelligence · REV 2.6
        </div>
        <h1 class="hero-title tac-display">
          What's getting<br />
          <span class="hero-accent">broken</span> today.
        </h1>
        <p class="hero-sub">
          Sentinel-Bench ingests CISA KEV, NVD, EPSS, GHSA, and MSRC into a single timeline prioritized by <em>real-world exploitation</em>, not inflated scores. Your vendor list, your filters, your feed.
        </p>
        <div class="hero-cta">
          <a href="/dashboard/" class="btn-primary">[ OPEN DASHBOARD &gt;&gt; ]</a>
          <a href="/sources/" class="btn-secondary">VIEW SOURCES ///</a>
        </div>
        <hr class="tac-rule" />
        <div class="hero-meta">
          <span><strong class="hero-stat">005</strong><span class="tac-label">SOURCES</span></span>
          <span class="dot"></span>
          <span><strong class="hero-stat">030<span class="hero-stat-unit">MIN</span></strong><span class="tac-label">CADENCE</span></span>
          <span class="dot"></span>
          <span><strong class="hero-stat">100<span class="hero-stat-unit">%</span></strong><span class="tac-label">OPEN SOURCE</span></span>
          <span class="dot"></span>
          <span class="status-live"><span class="status-dot"></span><span class="tac-label tac-label--phosphor">LIVE FEED</span></span>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="stats">
      <div class="stat">
        <div class="stat-num">5</div>
        <div class="stat-label"><span class="tac-label">OFFICIAL SOURCES</span><small>CISA KEV · NVD · EPSS · GHSA · MSRC</small></div>
      </div>
      <div class="stat">
        <div class="stat-num">30<span class="stat-unit">M</span></div>
        <div class="stat-label"><span class="tac-label">INGEST CADENCE</span><small>KEV + GHSA every 30 min</small></div>
      </div>
      <div class="stat">
        <div class="stat-num">4</div>
        <div class="stat-label"><span class="tac-label">FILTER LAYERS</span><small>vendor · domain · urgency · severity</small></div>
      </div>
      <div class="stat">
        <div class="stat-num">0</div>
        <div class="stat-label"><span class="tac-label">OUTBOUND TELEMETRY</span><small>no trackers · no analytics · no cookies</small></div>
      </div>
    </section>

    <!-- HOW IT LOOKS -->
    <section class="features">
      <div class="section-eyebrow tac-label tac-label--accent">/// SECTION 01 — INTERFACE</div>
      <h2 class="section-title tac-display">Three screens.<br />One decision.</h2>
      <div class="feature-grid">
        <article class="feature">
          <div class="feature-num">// 01</div>
          <h3>Feed prioritized by real-world exploitation</h3>
          <p>This isn't a list of CVEs. It's a list of things <em>someone</em> confirmed are actively breaking right now. Filter by domain (IT / OT), urgency (Act Now / Plan Patch / Monitor / Low Risk), and severity.</p>
        </article>
        <article class="feature">
          <div class="feature-num">// 02</div>
          <h3>Your vendors first</h3>
          <p>Pick the vendors you care about (Cisco, Microsoft, Apache, whatever you run). The feed collapses the noise. No infinite scroll, no 2,000 irrelevant vulns about products you don't run.</p>
        </article>
        <article class="feature">
          <div class="feature-num">// 03</div>
          <h3>KEV in one click</h3>
          <p>The CISA KEV catalog built in — the short list of "exploited in the wild, you need to patch." A single toggle. What shows in red is what's already costing money out there.</p>
        </article>
      </div>
    </section>

    <!-- WHY IT MATTERS -->
    <section class="why">
      <div class="why-grid">
        <div class="why-copy">
          <div class="section-eyebrow tac-label tac-label--accent">/// SECTION 02 — MOTIVATION</div>
          <h2 class="section-title tac-display">The public feed is noise.</h2>
          <p>
            NVD dumps <strong>40,000 CVEs per year</strong>. Less than 4% have a known public exploit. Less than 1% are actively being exploited. Sentinel-Bench cuts the 96% you don't need to see and leaves what you have to look at this week.
          </p>
          <p>
            This isn't a pretty dashboard — it's an operational tool. Built for the CISO who patches on Tuesdays and the pentester who needs a target list this week.
          </p>
        </div>
        <aside class="why-side">
          <div class="why-stat">
            <div class="why-stat-num">~03<span class="why-stat-unit">%</span></div>
            <div class="why-stat-label"><span class="tac-label">PUBLIC EXPLOIT</span><div class="why-stat-text">of published CVEs have a known public exploit</div></div>
          </div>
          <div class="why-stat">
            <div class="why-stat-num">~0.4<span class="why-stat-unit">%</span></div>
            <div class="why-stat-label"><span class="tac-label">IN KEV</span><div class="why-stat-text">are in CISA KEV (actively exploited in the wild)</div></div>
          </div>
          <div class="why-stat">
            <div class="why-stat-num">05<span class="why-stat-unit">M</span></div>
            <div class="why-stat-label"><span class="tac-label">DECISION TIME</span><div class="why-stat-text">how long it takes to open the feed and decide what to patch</div></div>
          </div>
        </aside>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="cta-final">
      <div class="cta-inner">
        <div class="section-eyebrow tac-label tac-label--phosphor">&gt;&gt;&gt; END OF LINE</div>
        <h2 class="tac-display">Try it in<br />30 seconds.</h2>
        <p>No signup. No cookies. No waitlist. The dashboard is open.</p>
        <div class="cta-buttons">
          <a href="/dashboard/" class="btn-primary">[ OPEN DASHBOARD &gt;&gt; ]</a>
          <a href="https://github.com/iamtweaks/sentinel-bench" rel="noopener" target="_blank" class="btn-secondary">GITHUB /// REPO</a>
        </div>
        <hr class="tac-rule" />
        <div class="cta-foot tac-label">
          BUILD 2026.08 · UNIT D-01 · MIT LICENSE · NO ANALYTICS
        </div>
      </div>
    </section>

  </main>

  <style>
    .landing {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 10;
    }

    /* HERO */
    .hero { padding: 88px 0 56px; }
    .hero-inner { max-width: 920px; }
    .hero-title {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: clamp(2.8rem, 7vw, 5.6rem);
      line-height: 0.92;
      font-weight: 900;
      letter-spacing: -0.045em;
      color: var(--text);
      text-transform: uppercase;
      margin: 20px 0 28px;
    }
    .hero-accent {
      color: var(--accent);
      text-shadow: 0 0 22px var(--accent-glow);
    }
    .hero-sub {
      font-size: 16px;
      line-height: 1.65;
      color: var(--text-dim);
      max-width: 680px;
      margin: 0 0 32px;
      border-left: 2px solid var(--accent);
      padding: 4px 0 4px 18px;
    }
    .hero-sub em {
      color: var(--text);
      font-style: normal;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      margin-bottom: 32px;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 14px 22px;
      background: var(--accent);
      color: var(--text);
      border: 1px solid var(--accent);
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 12.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background 0.12s ease;
    }
    .btn-primary:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
    }
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 14px 22px;
      background: transparent;
      color: var(--text);
      border: 1px solid var(--text);
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 12.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.12s ease;
    }
    .btn-secondary:hover {
      background: var(--text);
      color: var(--bg);
    }

    .hero-meta {
      display: flex;
      align-items: center;
      gap: 18px;
      font-size: 12px;
      color: var(--muted);
      flex-wrap: wrap;
      padding-top: 18px;
    }
    .hero-meta > span {
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
    }
    .hero-stat {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 18px;
      color: var(--text);
      letter-spacing: 0.02em;
    }
    .hero-stat-unit {
      font-size: 11px;
      color: var(--accent);
      margin-left: 2px;
      font-weight: 600;
    }
    .hero-meta .dot {
      width: 1px; height: 14px;
      background: var(--border-2);
    }
    .status-live {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .status-dot {
      width: 8px; height: 8px;
      background: var(--phosphor);
      box-shadow: 0 0 8px var(--phosphor);
      animation: blink 1.4s steps(2, end) infinite;
    }
    @keyframes blink {
      50% { opacity: 0.25; }
    }

    /* STATS — grid de paneles con 1px dividers */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      padding: 0;
      margin: 24px 0 64px;
      background: var(--border-2);
      border: 1px solid var(--border-2);
    }
    .stat {
      padding: 24px 22px;
      background: rgba(7, 9, 14, 0.78);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-right: 1px solid var(--border-2);
    }
    :root[data-theme="light"] .stat {
      background: rgba(248, 250, 252, 0.82);
    }
    .stat:last-child { border-right: none; }
    .stat-num {
      font-family: var(--font-mono);
      font-size: 56px;
      font-weight: 700;
      line-height: 1;
      color: var(--accent);
      letter-spacing: -0.04em;
      margin-bottom: 14px;
      text-shadow: 0 0 24px var(--accent-glow);
    }
    .stat-unit {
      font-size: 18px;
      color: var(--text);
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .stat-label {
      font-size: 12.5px;
      color: var(--text-dim);
      line-height: 1.5;
    }
    .stat-label small {
      display: block;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      margin-top: 6px;
    }

    /* SECTION GENERIC */
    .section-eyebrow {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--accent);
      text-transform: uppercase;
      margin-bottom: 18px;
    }
    .section-title {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: clamp(2rem, 4.4vw, 3.4rem);
      line-height: 0.92;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--text);
      text-transform: uppercase;
      margin: 0 0 40px;
      max-width: 720px;
    }

    /* FEATURES — sharp edges, industrial numbering */
    .features { padding: 24px 0 64px; }
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      background: var(--border-2);
      border: 1px solid var(--border-2);
    }
    .feature {
      background: rgba(7, 9, 14, 0.78);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      padding: 26px 22px 22px;
      border-right: 1px solid var(--border-2);
      transition: background 0.12s ease;
    }
    :root[data-theme="light"] .feature {
      background: rgba(248, 250, 252, 0.82);
    }
    .feature:last-child { border-right: none; }
    .feature:hover {
      background: rgba(20, 26, 36, 0.9);
    }
    :root[data-theme="light"] .feature:hover {
      background: rgba(238, 242, 246, 0.95);
    }
    .feature-num {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--accent);
      letter-spacing: 0.12em;
      margin-bottom: 16px;
    }
    .feature h3 {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 18px;
      font-weight: 800;
      color: var(--text);
      margin: 0 0 14px;
      line-height: 1.2;
      letter-spacing: -0.02em;
      text-transform: uppercase;
    }
    .feature p {
      font-size: 14px;
      line-height: 1.6;
      color: var(--text-dim);
      margin: 0;
    }
    .feature p em {
      color: var(--text);
      font-style: normal;
      font-weight: 700;
    }

    /* WHY */
    .why { padding: 56px 0 80px; border-top: 1px solid var(--border-2); }
    .why-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 0;
      background: var(--border-2);
      border: 1px solid var(--border-2);
    }
    .why-copy {
      background: rgba(7, 9, 14, 0.78);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      padding: 28px 26px;
      border-right: 1px solid var(--border-2);
    }
    :root[data-theme="light"] .why-copy {
      background: rgba(248, 250, 252, 0.82);
    }
    .why-copy p {
      font-size: 15px;
      line-height: 1.7;
      color: var(--text-dim);
      margin: 0 0 16px;
    }
    .why-copy p strong {
      color: var(--text);
      font-weight: 700;
    }
    .why-side {
      background: rgba(7, 9, 14, 0.78);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      padding: 0;
    }
    :root[data-theme="light"] .why-side {
      background: rgba(248, 250, 252, 0.82);
    }
    .why-stat {
      padding: 22px 24px;
      border-bottom: 1px solid var(--border-2);
    }
    .why-stat:last-child { border-bottom: none; }
    .why-stat-num {
      font-family: var(--font-mono);
      font-size: 36px;
      font-weight: 700;
      color: var(--accent);
      letter-spacing: -0.03em;
      line-height: 1;
      margin-bottom: 14px;
      text-shadow: 0 0 18px var(--accent-glow);
    }
    .why-stat-unit {
      font-size: 18px;
      color: var(--text);
      margin-left: 4px;
    }
    .why-stat-label {
      font-size: 12.5px;
      color: var(--text-dim);
      line-height: 1.5;
    }
    .why-stat-text {
      color: var(--text);
      margin-top: 4px;
      font-size: 13px;
    }

    /* CTA FINAL */
    .cta-final {
      padding: 80px 0 96px;
      border-top: 1px solid var(--border-2);
      text-align: center;
    }
    .cta-inner { max-width: 680px; margin: 0 auto; }
    .cta-final h2 {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: clamp(2.2rem, 5vw, 3.8rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--text);
      text-transform: uppercase;
      line-height: 0.92;
      margin: 0 0 18px;
    }
    .cta-final p {
      font-size: 14px;
      color: var(--text-dim);
      margin: 0 0 28px;
    }
    .cta-buttons {
      display: flex;
      gap: 0;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 32px;
    }
    .cta-foot {
      padding-top: 20px;
      text-align: center;
      color: var(--muted);
    }



    @media (max-width: 880px) {
      .hero { padding: 56px 0 40px; }
      .stats {
        grid-template-columns: repeat(2, 1fr);
      }
      .stat {
        border-right: 1px solid var(--border-2);
        border-bottom: 1px solid var(--border-2);
      }
      .stat:nth-child(2n) { border-right: none; }
      .stat:nth-last-child(-n+2) { border-bottom: none; }
      .feature-grid {
        grid-template-columns: 1fr;
      }
      .feature {
        border-right: none;
        border-bottom: 1px solid var(--border-2);
      }
      .feature:last-child { border-bottom: none; }
      .why-grid {
        grid-template-columns: 1fr;
      }
      .why-copy {
        border-right: none;
        border-bottom: 1px solid var(--border-2);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .status-dot { animation: none; }
      .btn-primary, .btn-secondary, .feature {
        transition: none;
      }
    }
  </style>

</Base>

