---
import Base from '../layouts/Base.astro';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const SUPABASE_URL_JSON = JSON.stringify(SUPABASE_URL);
const SUPABASE_ANON_JSON = JSON.stringify(SUPABASE_ANON);
---
<Base title="Sentinel-Bench — Vulnerability Feed" active="dashboard">
  <main class="feed-layout">
    
    <!-- COLUMN 1: LEFT VENDOR SIDEBAR (Top-to-Bottom full height) -->
    <aside class="vendor-sidebar">
      <div>
        <div class="sidebar-header-row">
          <span class="tac-label tac-label--accent">// ASSETS</span>
          <span class="tac-telemetry-badge">LIVE</span>
        </div>
        <div class="sidebar-main-title">Monitored Vendors</div>
        <div class="sidebar-subtitle">Select vendors to isolate target surface.</div>
        <div class="vendor-search">
          <span class="search-icon">&gt;</span>
          <input id="vendor-search-input" type="text" placeholder="FILTER VENDORS..." spellcheck="false" />
        </div>
      </div>
      <div id="vendor-list-container" class="vendor-list">
        <div class="sidebar-loading">INITIALIZING ASSET REPO...</div>
      </div>
    </aside>

    <!-- COLUMN 2: MIDDLE THREAT FEED -->
    <section class="feed-column">
      <div class="feed-header">
        <div class="feed-header-top">
          <span class="tac-label tac-label--accent">// THREAT_STREAM</span>
          <span class="status-live">
            <span class="status-dot"></span>
            <span class="tac-label tac-label--phosphor">FEED ONLINE</span>
          </span>
        </div>
        <div class="feed-title">Active Vulnerability Stream</div>
        <div class="feed-subtitle">
          Synchronized <span id="feed-updated-time">just now</span> · Tracking <span id="feed-count" class="feed-count-badge">—</span> advisories
        </div>
      </div>

      <!-- FILTER SECTIONS WRAP (Domain, Urgency & Severity) -->
      <div class="filter-sections-wrap">
        <div class="filter-wrap-header">
          <span class="tac-label">// TELEMETRY FILTERS</span>
          <span class="tac-filter-status">[ REAL-TIME PARSING ]</span>
        </div>

        <!-- DOMAIN FILTER (All / IT / OT) -->
        <div class="filter-row">
          <span class="filter-row-label">Domain</span>
          <div class="chip-group">
            <button class="chip-btn is-active" data-filter="domain" data-val="">All</button>
            <button class="chip-btn" data-filter="domain" data-val="IT">IT</button>
            <button class="chip-btn" data-filter="domain" data-val="OT">OT / ICS</button>
          </div>
        </div>

        <!-- URGENCY TIER FILTER (Act Now, Plan Patch, Monitor, Low Risk) -->
        <div class="filter-row">
          <span class="filter-row-label">Urgency</span>
          <div class="chip-group">
            <button class="chip-btn is-active" data-filter="tier" data-val="all">All</button>
            <button class="chip-btn chip-tier-act" data-filter="tier" data-val="act">Act Now</button>
            <button class="chip-btn chip-tier-plan" data-filter="tier" data-val="plan">Plan Patch</button>
            <button class="chip-btn chip-tier-mon" data-filter="tier" data-val="mon">Monitor</button>
            <button class="chip-btn chip-tier-risk" data-filter="tier" data-val="risk">Low Risk</button>
          </div>
        </div>

        <!-- SEVERITY FILTER (Critical, High, Medium, Low) -->
        <div class="filter-row">
          <span class="filter-row-label">Severity</span>
          <div class="chip-group">
            <button class="chip-btn is-active" data-filter="severity" data-val="">All</button>
            <button class="chip-btn chip-crit" data-filter="severity" data-val="CRITICAL">Critical</button>
            <button class="chip-btn chip-high" data-filter="severity" data-val="HIGH">High</button>
            <button class="chip-btn chip-med" data-filter="severity" data-val="MEDIUM">Medium</button>
            <button class="chip-btn chip-low" data-filter="severity" data-val="LOW">Low</button>
          </div>
        </div>
      </div>

      <!-- SEARCH, SORT & EXPORT BAR -->
      <div class="feed-actions">
        <div class="feed-search">
          <span class="search-icon">&gt;</span>
          <input id="feed-search-input" type="text" placeholder="Search CVEs, vendors, keywords... [ / ]" spellcheck="false" />
        </div>
        <select id="feed-sort-select" class="select-sort">
          <option value="score">Sort: Highest Score</option>
          <option value="newest">Sort: Most Recent</option>
          <option value="epss">Sort: Highest EPSS</option>
        </select>
        <button id="btn-export-csv" class="btn-export">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>[ EXPORT CSV ]</span>
        </button>
      </div>

      <!-- ACTIVE FILTERS CHIPS BAR -->
      <div id="active-tags-container" class="active-tags-bar">
        <!-- Rendered dynamically -->
      </div>

      <!-- ADVISORY CARDS LIST -->
      <div id="feed-cards-container" class="feed-cards">
        <div class="detail-placeholder">Loading threat intelligence…</div>
      </div>
    </section>

  </main>

  <!-- SLIDING RIGHT SIDE PANEL (DRAWER) -->
  <div id="drawer-backdrop" class="drawer-backdrop"></div>
  <aside id="side-drawer" class="side-drawer">
    <!-- Rendered dynamically via renderDetailPanel -->
  </aside>

  <script is:inline set:html={`window.__SB_URL = ${SUPABASE_URL_JSON}; window.__SB_ANON = ${SUPABASE_ANON_JSON};`}></script>
  <script>
    import { sb } from '../lib/sb';
    import { renderFeedCards, renderDetailPanel, renderVendorSidebar, statusFor } from '../lib/render';

    if (!sb) {
      document.getElementById('feed-cards-container').innerHTML =
        '<div class="detail-placeholder" style="color:var(--crit)">Missing PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY. Configure the env vars in Vercel.</div>';
    } else {
      const state = {
        rows: [],
        activeCveId: null as string | null,
        drawerOpen: false,
        sortBy: 'score',
        filters: {
          domain: '',
          search: '',
          tier: 'all',
          severity: '',
          vendors: new Set<string>(),
          vendorQuery: '',
        },
        vendorCounts: {} as Record<string, number>,
      };

      async function loadData() {
        // Query latest_risk_scores view first (Postgres-optimized), fallback to risk_scores table
        let scoresRes = await sb.from('latest_risk_scores').select('cve_id, score, factors, rationale, computed_at').order('score', { ascending: false }).limit(500);
        if (scoresRes.error) {
          scoresRes = await sb.from('risk_scores').select('cve_id, score, factors, rationale, computed_at').order('computed_at', { ascending: false }).limit(2000);
        }

        const otRes = await sb.from('advisories').select('id, title, summary, url, severity, published_at, vendors, cve_ids, domain').eq('domain', 'OT').order('published_at', { ascending: false, nullsFirst: false }).limit(200);

        if (scoresRes.error && otRes.error) {
          document.getElementById('feed-cards-container').innerHTML = `<div class="detail-placeholder" style="color:var(--crit)">Error loading data from Supabase.</div>`;
          return;
        }

        const seen = new Set<string>();
        const top: any[] = [];

        for (const r of scoresRes.data || []) {
          if (seen.has(r.cve_id)) continue;
          seen.add(r.cve_id);
          top.push({ ...r, domain: 'IT' });
        }

        const cveIds = top.map(r => r.cve_id);
        let vulns: any[] = [];
        if (cveIds.length) {
          const { data } = await sb.from('vulnerabilities')
            .select('cve_id,cvss_v3_score,epss_score,is_kev,vendors,products,exploited_in_wild,poc_public,poc_urls,refs,last_updated_at,description,remediation')
            .in('cve_id', cveIds);
          vulns = data || [];
        }

        const vmap = Object.fromEntries(vulns.map((v: any) => [v.cve_id, v]));
        const itRows = top.map(s => ({ ...s, vuln: vmap[s.cve_id] || {} }));

        // Map OT advisories
        const otRows = (otRes.data || []).map((a: any) => {
          const cve = (Array.isArray(a.cve_ids) && a.cve_ids.length > 0) ? a.cve_ids[0] : (a.id || 'OT-ADVISORY');
          const sevMap: Record<string, number> = { CRITICAL: 88, HIGH: 68, MEDIUM: 48, LOW: 20 };
          const approxScore = sevMap[String(a.severity).toUpperCase()] || 50;
          return {
            cve_id: cve,
            score: approxScore,
            domain: 'OT',
            rationale: a.summary || a.title,
            computed_at: a.published_at,
            vuln: {
              cve_id: cve,
              cvss_v3_score: a.severity === 'CRITICAL' ? 9.2 : a.severity === 'HIGH' ? 7.8 : 5.5,
              epss_score: 0.15,
              is_kev: String(a.severity).toUpperCase() === 'CRITICAL',
              vendors: a.vendors || ['OT Vendor'],
              products: [],
              exploited_in_wild: false,
              poc_public: false,
              last_updated_at: a.published_at,
              description: a.summary || a.title,
            }
          };
        });

        state.rows = [...itRows, ...otRows];

        // Count vendors across both IT & OT
        const counts: Record<string, number> = {};
        for (const r of state.rows) {
          const vendorList = r.vuln?.vendors;
          if (Array.isArray(vendorList) && vendorList.length) {
            for (const v of vendorList) {
              const formatted = String(v).trim();
              if (formatted) counts[formatted] = (counts[formatted] || 0) + 1;
            }
          } else {
            counts['General'] = (counts['General'] || 0) + 1;
          }
        }
        state.vendorCounts = counts;

        renderAll();
      }

      function applyFilters(rows: any[]) {
        const { search, tier, severity, domain, vendors } = state.filters;
        return rows.filter((r: any) => {
          const v = r.vuln || {};
          const status = statusFor(r.score, v.is_kev);

          // Domain Filter (IT vs OT vs Both)
          if (domain && r.domain !== domain) return false;

          // Tier Filter
          if (tier !== 'all' && status !== tier) return false;

          // Severity Filter
          if (severity) {
            const cvss = v.cvss_v3_score;
            if (severity === 'CRITICAL' && !(cvss >= 9.0)) return false;
            if (severity === 'HIGH' && !(cvss >= 7.0 && cvss < 9.0)) return false;
            if (severity === 'MEDIUM' && !(cvss >= 4.0 && cvss < 7.0)) return false;
            if (severity === 'LOW' && !(cvss !== null && cvss < 4.0)) return false;
          }

          // Vendor Filter
          if (vendors.size > 0) {
            const rowVendors = v.vendors || ['General'];
            const matchesVendor = rowVendors.some((vendor: string) => vendors.has(vendor));
            if (!matchesVendor) return false;
          }

          // Search Filter
          if (search) {
            const q = search.toLowerCase();
            const text = `${r.cve_id} ${(v.vendors || []).join(' ')} ${(v.products || []).join(' ')} ${v.description || ''}`.toLowerCase();
            if (!text.includes(q)) return false;
          }

          return true;
        });
      }

      function sortRows(rows: any[]) {
        if (state.sortBy === 'score') {
          return rows.sort((a, b) => b.score - a.score);
        } else if (state.sortBy === 'newest') {
          return rows.sort((a, b) => new Date(b.vuln?.last_updated_at || b.computed_at).getTime() - new Date(a.vuln?.last_updated_at || a.computed_at).getTime());
        } else if (state.sortBy === 'epss') {
          return rows.sort((a, b) => (b.vuln?.epss_score || 0) - (a.vuln?.epss_score || 0));
        }
        return rows;
      }

      function openDrawer(cve: string) {
        state.activeCveId = cve;
        state.drawerOpen = true;
        const activeRow = state.rows.find((r: any) => r.cve_id === cve) || null;
        renderDetailPanel(document.getElementById('side-drawer'), activeRow, closeDrawer);
        document.getElementById('side-drawer')?.classList.add('is-open');
        document.getElementById('drawer-backdrop')?.classList.add('is-open');
        renderAllCardsOnly();
      }

      function closeDrawer() {
        state.drawerOpen = false;
        state.activeCveId = null;
        document.getElementById('side-drawer')?.classList.remove('is-open');
        document.getElementById('drawer-backdrop')?.classList.remove('is-open');
        renderAllCardsOnly();
      }

      function renderAllCardsOnly() {
        let filtered = applyFilters(state.rows);
        filtered = sortRows(filtered);
        const container = document.getElementById('feed-cards-container');
        renderFeedCards(container, filtered, state.activeCveId, (selectedCve: string) => {
          openDrawer(selectedCve);
        });
      }

      function renderAll() {
        let filtered = applyFilters(state.rows);
        filtered = sortRows(filtered);

        // ponytail: show "—" while data hasn't loaded yet so users don't read 0 as "nothing to worry about".
        document.getElementById('feed-count').textContent = state.rows.length === 0
          ? '—'
          : filtered.length.toLocaleString();

        renderAllCardsOnly();
        renderActiveChips();

        renderVendorSidebar(
          document.getElementById('vendor-list-container'),
          filterVendorCounts(),
          state.filters.vendors,
          (vendorToggle: string) => {
            if (state.filters.vendors.has(vendorToggle)) {
              state.filters.vendors.delete(vendorToggle);
            } else {
              state.filters.vendors.add(vendorToggle);
            }
            renderAll();
          }
        );
      }

      function filterVendorCounts() {
        const q = state.filters.vendorQuery.toLowerCase();
        if (!q) return state.vendorCounts;
        const res: Record<string, number> = {};
        for (const [k, v] of Object.entries(state.vendorCounts)) {
          if (k.toLowerCase().includes(q)) res[k] = v;
        }
        return res;
      }

      function renderActiveChips() {
        const container = document.getElementById('active-tags-container');
        const chips: string[] = [];

        if (state.filters.domain) {
          chips.push(`<span class="active-chip">Domain: ${state.filters.domain} <button data-remove="domain">✕</button></span>`);
        }

        if (state.filters.tier !== 'all') {
          const labels: Record<string, string> = { act: 'Urgency: Act Now', plan: 'Urgency: Plan Patch', mon: 'Urgency: Monitor', risk: 'Urgency: Low Risk' };
          chips.push(`<span class="active-chip">${labels[state.filters.tier]} <button data-remove="tier">✕</button></span>`);
        }

        if (state.filters.severity) {
          chips.push(`<span class="active-chip">Severity: ${state.filters.severity} <button data-remove="severity">✕</button></span>`);
        }

        for (const vendor of state.filters.vendors) {
          chips.push(`<span class="active-chip">Vendor: ${vendor} <button data-remove-vendor="${vendor}">✕</button></span>`);
        }

        if (chips.length > 0) {
          chips.push(`<button class="btn-clear-all" id="btn-clear-filters">Clear all</button>`);
          container.innerHTML = chips.join('');

          container.querySelectorAll('[data-remove]').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const key = (e.currentTarget as HTMLElement).dataset.remove;
              if (key === 'domain') state.filters.domain = '';
              if (key === 'tier') state.filters.tier = 'all';
              if (key === 'severity') state.filters.severity = '';
              updateFilterButtons();
              renderAll();
            });
          });

          container.querySelectorAll('[data-remove-vendor]').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const v = (e.currentTarget as HTMLElement).dataset.removeVendor;
              if (v) state.filters.vendors.delete(v);
              renderAll();
            });
          });

          document.getElementById('btn-clear-filters')?.addEventListener('click', () => {
            state.filters.domain = '';
            state.filters.tier = 'all';
            state.filters.severity = '';
            state.filters.vendors.clear();
            state.filters.search = '';
            (document.getElementById('feed-search-input') as HTMLInputElement).value = '';
            updateFilterButtons();
            renderAll();
          });
        } else {
          container.innerHTML = '';
        }
      }

      function updateFilterButtons() {
        document.querySelectorAll<HTMLElement>('.chip-btn[data-filter="domain"]').forEach(btn => {
          btn.classList.toggle('is-active', (btn.dataset.val ?? '') === state.filters.domain);
        });
        document.querySelectorAll<HTMLElement>('.chip-btn[data-filter="tier"]').forEach(btn => {
          btn.classList.toggle('is-active', (btn.dataset.val ?? 'all') === state.filters.tier);
        });
        document.querySelectorAll<HTMLElement>('.chip-btn[data-filter="severity"]').forEach(btn => {
          btn.classList.toggle('is-active', (btn.dataset.val ?? '') === state.filters.severity);
        });
      }

      // Filter Button Event Listeners
      document.querySelectorAll<HTMLElement>('.chip-btn[data-filter]').forEach(btn => {
        btn.addEventListener('click', () => {
          const type = btn.dataset.filter as 'domain' | 'tier' | 'severity';
          const val = btn.dataset.val ?? '';
          (state.filters as any)[type] = val;
          updateFilterButtons();
          renderAll();
        });
      });

      document.getElementById('drawer-backdrop')?.addEventListener('click', closeDrawer);

      document.getElementById('feed-search-input')?.addEventListener('input', (e) => {
        state.filters.search = (e.target as HTMLInputElement).value;
        renderAll();
      });

      document.getElementById('vendor-search-input')?.addEventListener('input', (e) => {
        state.filters.vendorQuery = (e.target as HTMLInputElement).value;
        renderVendorSidebar(
          document.getElementById('vendor-list-container'),
          filterVendorCounts(),
          state.filters.vendors,
          (v: string) => {
            if (state.filters.vendors.has(v)) state.filters.vendors.delete(v);
            else state.filters.vendors.add(v);
            renderAll();
          }
        );
      });

      document.getElementById('feed-sort-select')?.addEventListener('change', (e) => {
        state.sortBy = (e.target as HTMLSelectElement).value;
        renderAll();
      });

      // Keyboard shortcut: '/' to focus feed search
      window.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
          e.preventDefault();
          const input = document.getElementById('feed-search-input') as HTMLInputElement | null;
          input?.focus();
          input?.select();
        }
      });

      // CSV Export
      document.getElementById('btn-export-csv')?.addEventListener('click', () => {
        const filtered = sortRows(applyFilters(state.rows));
        if (!filtered.length) return alert('No vulnerabilities to export.');

        const headers = ['CVE_ID', 'Domain', 'Score', 'CVSS', 'EPSS', 'KEV', 'Exploited_In_Wild', 'PoC_Public', 'Vendors', 'Description'];
        const csvRows = [headers.join(',')];

        for (const r of filtered) {
          const v = r.vuln || {};
          // ponytail: strip newlines from description so CSV stays single-row and Excel doesn't split rows.
          const desc = (v.description || '').replace(/[\r\n]+/g, ' ').replace(/"/g, '""').slice(0, 300);
          const row = [
            `"${r.cve_id}"`,
            `"${r.domain || 'IT'}"`,
            r.score.toFixed(1),
            v.cvss_v3_score != null ? v.cvss_v3_score : '',
            v.epss_score != null ? (v.epss_score * 100).toFixed(2) + '%' : '',
            v.is_kev ? 'Yes' : 'No',
            v.exploited_in_wild ? 'Yes' : 'No',
            v.poc_public ? 'Yes' : 'No',
            `"${(v.vendors || []).join(';')}"`,
            `"${desc}"`
          ];
          csvRows.push(row.join(','));
        }

        const blob = new Blob([csvRows.join('\n')], { type: 'text/csv' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `sentinel-bench-feed-${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        URL.revokeObjectURL(url);
      });

      loadData();
    }
  </script>
</Base>
